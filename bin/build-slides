#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT_DIR="$ROOT/build"
DECK="$ROOT/slides/tropical-ruby-2026.md"
BROWSER="$ROOT/bin/chromium-no-sandbox"
NAME="$("$ROOT/bin/deck-name")"
OUT="$OUT_DIR/$NAME"

mkdir -p "$OUT_DIR"
echo "Building build/$NAME.{html,pdf,pptx,with-video.pptx}"

"$ROOT/bin/marp" "$DECK" --html -o "$OUT.html"
"$ROOT/bin/marp" "$DECK" --pdf --browser chrome --browser-path "$BROWSER" --browser-timeout 120 -o "$OUT.pdf"
"$ROOT/bin/marp" "$DECK" --pptx --browser chrome --browser-path "$BROWSER" --browser-timeout 120 -o "$OUT.pptx"
python "$ROOT/bin/inject_notes_pptx.py" "$OUT.pptx"
"$ROOT/bin/embed-videos-pptx" "$OUT.pptx" "$OUT.with-video.pptx"

# Point the site's root redirect at this build's HTML.
sed -i -E "s#build/[A-Za-z0-9._-]+\.html#build/$NAME.html#g" "$ROOT/index.html"
