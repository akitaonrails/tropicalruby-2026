#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT_DIR="$ROOT/build"
DECK="$ROOT/slides/tropical-ruby-2026.md"
BROWSER="$ROOT/bin/chromium-no-sandbox"

mkdir -p "$OUT_DIR"

"$ROOT/bin/marp" "$DECK" --html -o "$OUT_DIR/tropical-ruby-2026.html"
"$ROOT/bin/marp" "$DECK" --pdf --browser chrome --browser-path "$BROWSER" -o "$OUT_DIR/tropical-ruby-2026.pdf"
"$ROOT/bin/marp" "$DECK" --pptx --browser chrome --browser-path "$BROWSER" -o "$OUT_DIR/tropical-ruby-2026.pptx"
"$ROOT/bin/embed-videos-pptx" "$OUT_DIR/tropical-ruby-2026.pptx" "$OUT_DIR/tropical-ruby-2026.with-video.pptx"
